# Copy to .env (never commit .env). Dev-only values.
POSTGRES_USER=platform
POSTGRES_PASSWORD=change_me
RABBITMQ_USER=platform
RABBITMQ_PASSWORD=change_me
# At least 32 chars. Shared by auth-service (signs) and gateway/services (verify).
JWT_SECRET=change_me_to_a_long_random_string_of_32_plus_chars
